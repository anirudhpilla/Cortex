
APP_NAME=Cortex
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://docsearch:replace-me@localhost:5432/docsearch
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
PG_COLLECTION_NAME=cortex

FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=cortex-api
JWT_AUDIENCE=cortex-admin
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_DAYS=7
COOKIE_SECURE=false

LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=ollama
OPENAI_API_KEY=
GOOGLE_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

EMBEDDING_DIMENSIONS=768
EMBEDDING_MODEL_VERSION=nomic-embed-text

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=8
CANDIDATE_K=30
MAX_QUERY_EVIDENCE_TOKENS=12000
REQUEST_TIMEOUT_SECONDS=60

MAX_FILE_BYTES=2000000
MAX_REPOSITORY_FILES=50000
MAX_REPOSITORY_BYTES=2000000000
REPOSITORY_BASE_PATH=/app/documents

REDIS_URL=redis://localhost:6379/0
